{
  "expo": {
    "sdkVersion": "54.0.0",
    "name": "AabRahat",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.urbanwaters.tankerapp"
    },
    "android": {
      "package": "com.urbanwaters.tankerapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#063B5C"
      },
      "versionCode": 5
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f9a94d0b-f9e2-40d8-b936-f48add4cbf65"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "AabRahat uses your camera to scan QR invite codes for shared device access."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AabRahat uses your location to set accurate delivery addresses and, for drivers, to share live location during deliveries."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9a94d0b-f9e2-40d8-b936-f48add4cbf65"
      }
    },
    "owner": "umar13280"
  }
}
